MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/<db-name>?retryWrites=true&w=majority&appName=<app-name>
COOKIE_SECRET=<random long random string, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`>
ADMIN_PASSWORD=<the password you'll use to log in and manage posts>
CLOUDINARY_CLOUD_NAME=<from your Cloudinary dashboard>
CLOUDINARY_API_KEY=<from your Cloudinary dashboard>
CLOUDINARY_API_SECRET=<from your Cloudinary dashboard>
