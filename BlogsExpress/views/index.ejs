<html lang="en">
<%- include("./partials/head.ejs") %>

<body>
  <%- include("./partials/nav.ejs") %>

  <div class="blogs content">
    <div class="page-header">
      <span class="eyebrow">Latest posts</span>
      <h2>All Blogs</h2>
      <p class="lede">Life in tech, software development, and everything in between. Carpe Diem!</p>
    </div>

    <% if (blogs.length > 0) { %>
      <div class="blog-grid">
        <% blogs.forEach(blog => { %>
          <a class="blog-card" href="/blogs/<%= blog._id %>">
            <% if (blog.image && (blog.fileType === 'pdf' || blog.image.toLowerCase().endsWith('.pdf'))) { %>
              <% if (blog.thumbnail) { %>
                <img class="thumb pdf-page-thumb" src="<%= blog.thumbnail %>" alt="<%= blog.title %> (PDF preview)">
              <% } else { %>
                <div class="thumb placeholder pdf-thumb">PDF</div>
              <% } %>
            <% } else if (blog.image) { %>
              <img class="thumb" src="<%= blog.image %>" alt="<%= blog.title %>">
            <% } else { %>
              <div class="thumb placeholder"><%= blog.title.slice(0, 1).toUpperCase() %></div>
            <% } %>
            <div class="card-body">
              <span class="date"><%= new Date(blog.publishDate || blog.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %></span>
              <h3 class="title"><%= blog.title %></h3>
              <p class="snippet"><%= blog.snippet %></p>
              <span class="read-more">Read more &rarr;</span>
            </div>
          </a>
        <% }) %>
      </div>
    <% } else { %>
      <div class="empty-state">
        <div class="icon">📝</div>
        <p>There are no blogs to display yet.</p>
      </div>
    <% } %>

  </div>

  <%- include("./partials/footer.ejs") %>
</body>
</html>