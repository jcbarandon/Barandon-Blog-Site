<html lang="en">
<%- include("./partials/head.ejs") %>

<body>
  <%- include("./partials/nav.ejs") %>

  <div class="details content">
    <a href="/blogs" class="back-link">&larr; Back to all blogs</a>

    <h2><%= blog.title %></h2>
    <span class="date"><%= new Date(blog.publishDate || blog.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></span>

    <% if (blog.image) { %>
      <% if (blog.fileType === 'pdf' || blog.image.toLowerCase().endsWith('.pdf')) { %>
        <div class="pdf-embed">
          <iframe src="<%= blog.image %>" title="<%= blog.title %> PDF" class="pdf-frame"></iframe>
          <a href="<%= blog.image %>" target="_blank" rel="noopener" class="btn btn-primary pdf-link">View / Download PDF</a>
        </div>
      <% } else { %>
        <img src="<%= blog.image %>" alt="<%= blog.title %>" class="blog-img">
      <% } %>
    <% } %>

    <div class="content">
      <p><%= blog.body %></p>
    </div>

    <% if (isAuthed) { %>
      <div class="detail-actions">
        <!-- ✏️ Edit button -->
        <a href="/blogs/<%= blog._id %>/edit" class="btn btn-primary edit-btn">Edit Blog</a>

        <!-- 🗑 Delete button -->
        <a class="btn-icon delete" data-doc="<%= blog._id %>" title="Delete blog">
          <svg xmlns="http://www.w3.org/2000/svg" height="18" width="18" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/></svg>
        </a>
      </div>
    <% } %>
  </div>

  <%- include("./partials/footer.ejs") %>

  <% if (isAuthed) { %>
    <script>
      const trashcan = document.querySelector('a.delete');

      trashcan.addEventListener('click', (e) => {
        const endpoint = `/blogs/${trashcan.dataset.doc}`;

        fetch(endpoint, {
          method: 'DELETE',
        })
        .then(response => response.json())
        .then(data => window.location.href = data.redirect)
        .catch(err => console.log(err));
      });
    </script>
  <% } %>
</body>
</html>
