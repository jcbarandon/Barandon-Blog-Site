<html lang="en">
<%- include("./partials/head.ejs") %>

<body>
  <%- include("./partials/nav.ejs") %>

  <div class="create-blog content">
    <div class="page-header">
      <span class="eyebrow">New post</span>
      <h2>Create a Blog</h2>
    </div>

    <form action="/blogs" method="POST" data-cloud-name="<%= cloudinaryCloudName %>" data-upload-preset="<%= cloudinaryUploadPreset %>">
      <label for="title">Blog title:</label>
      <input type="text" id="title" name="title" required>

      <label for="snippet">Blog snippet:</label>
      <input type="text" id="snippet" name="snippet" required>

      <label for="body">Blog body:</label>
      <textarea id="body" name="body" required></textarea>

      <label for="date">Publish date:</label>
      <input type="date" id="date" name="date" value="<%= new Date().toISOString().slice(0, 10) %>">

      <label for="image">Optional blog image or PDF:</label>
      <input type="file" name="image" id="image" accept="image/*,application/pdf">

      <button>Submit</button>
    </form>
  </div>

  <%- include("./partials/footer.ejs") %>

  <script src="/upload.js" defer></script>
</body>
</html>
